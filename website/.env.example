# Copy to .env.local for local dev, or set these as Environment Variables in Vercel.
# You get both values from the ThreatWatch dashboard: Settings -> Integrations ->
# (your site) -> "Agent setup".

# Base URL of your running ThreatWatch backend (no trailing slash).
# Local dev example: http://localhost:8000
# Production example: https://threatwatch-api.yourdomain.com
TW_INGEST_URL=

# The per-site ingest key issued when you added this website as an integration.
TW_INGEST_KEY=
